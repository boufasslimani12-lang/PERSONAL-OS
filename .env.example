# Optional. The app defaults to the confirmed project's public Supabase URL + publishable key
# (lib/supabase/config.ts). Set these only to use a different Supabase project. Never add a service-role key.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Set to "true" only while creating your single account, then set back to "false"
# (and disable sign-ups in Supabase → Authentication → Providers → Email).
NEXT_PUBLIC_ALLOW_SIGNUP=false
