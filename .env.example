# Copy to .env.local and fill in. Never commit real values.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Set to "true" only while creating your single account, then set back to "false"
# (and disable sign-ups in Supabase → Authentication → Providers → Email).
NEXT_PUBLIC_ALLOW_SIGNUP=false
